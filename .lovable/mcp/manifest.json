{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "zenzyy-mcp",
      "version": "0.1.0",
      "title": "Zenzyy Water Parks"
    },
    "tools": [
      {
        "name": "list_parks",
        "title": "List water parks",
        "description": "List all water parks available for booking on Zenzyy, including name, location, and price.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Optional case-insensitive substring to filter by park name or location.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_park",
        "title": "Get park details",
        "description": "Fetch full details for one water park by its ID.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "park_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The park's UUID."
            }
          },
          "required": [
            "park_id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
